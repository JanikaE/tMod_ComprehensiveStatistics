Keybinds.ToggleStatistics.DisplayName: 打开或关闭统计窗口

UI: {
	WindowTitle: 综合统计
	EmptyWindow: 统计分类将在下一开发步骤中加入。
	OpenButtonTooltip:
		'''
		综合统计
		按住右键可拖动此按钮
		'''
	CloseButtonTooltip: 关闭
	StatisticsStartedAt: 统计开始时间：{0:g}
	StatisticsStartUnavailable: 尚未进入世界，无可用的统计开始时间。
	B2PersistenceTestCounter: B2 临时测试 · 进入世界次数：{0:N0}

	Survival: {
		DeathSourcesGroup: 死亡次数
		DirectDeathGroup: 直接伤害
		ContinuousDeathGroup: 持续伤害
		UnknownDeathSource: 其他或此前未分类
		UnclassifiedNpcDeath: 其他或此前未分类
		DirectDamageGroup: 直接伤害总量
		ContinuousLifeLossGroup: 持续伤害
		MultipleContinuousDamageEffects: 多个持续伤害效果
		UnknownContinuousLifeLoss: 未知
		UnclassifiedNpcDamage: 其他或此前未分类
		MissingNpcContent: 缺失内容：{0}
		MissingBuffContent: 缺失 Debuff：{0}

		DirectDamageSources: {
			NpcContact: NPC 接触伤害
			HostileProjectile: 敌对弹幕
			PvP: PvP 玩家或弹幕
			Fall: 摔落
			Drowning: 溺水
			Lava: 熔岩
			TrapOrTile: 陷阱或物块
			Other: 其他或此前未分类
		}
	}

	Tabs: {
		Overview: {
			Title: 综合概览
			Description: 这里将显示各类统计的代表性总计和常用摘要。
		}

		Blocks: {
			Title: 物块
			Description: 这里将显示实体物块、背景墙和家具或多格物体的拆除统计。
		}

		Items: {
			Title: 物品
			Description: 这里将显示物品拾取与物品使用统计。
		}

		Interactions: {
			Title: 设施交互
			Description: 这里将显示增益站、家具、容器、晶塔、钟和机关的交互统计。
		}

		NPCs: {
			Title: NPC
			Description: 这里将显示 NPC 对话、击杀、协助和世界死亡统计。
		}

		Economy: {
			Title: 经济
			Description: 这里将显示买入、卖出、护士治疗、重铸和货币流量统计。
		}

		Fishing: {
			Title: 钓鱼
			Description: 这里将显示抛竿、上钩、空竿或中断以及渔获统计。
		}

		Movement: {
			Title: 移动
			Description: 这里将显示总移动距离以及各类移动方式的距离统计。
		}

		Survival: {
			Title: 生存
			Description: 这里将显示死亡、掉血和伤害来源统计。
		}
	}

	List: {
		MetricColumn: 数量 / 次数
		EventsColumn: 次数
		AmountColumn: 实际掉血
		ValueColumn: 数值
		NoResults: 没有符合当前条件的条目
		SortDescending: 数量 ↓
		SortAscending: 数量 ↑
		SortName: 名称 A–Z
		MetricFormat: "{0:N0} 个 / {1:N0} 次"
		EventsFormat: "{0:N0} 次"
		AmountFormat: "{0:N0}"
		DemoPickupGroup: 临时数据：物品拾取
		DemoUseGroup: 临时数据：物品使用
		DemoModdedPickup: 模组物品示例：星辉碎片
		DemoModdedUse: 模组物品零值示例
	}

	Toolbar: {
		SearchHint: 搜索名称…
		ScopeCareer: 角色生涯
		ScopeCurrentWorld: 角色当前世界
		ScopeWorldPublic: 世界公共
		ScopeCareerDescription: 范围：该角色的全部生涯。
		ScopeCurrentWorldDescription: 范围：该角色所在的当前世界。
		ScopeWorldPublicDescription: 范围：当前世界的公共数据。
		ScopedTitleFormat: "{0} · {1}"
		ScopedDescriptionFormat: "{0} {1}"
		SortDescending: 数量 ↓
		SortAscending: 数量 ↑
		SortName: 名称 A–Z
		SourceAll: 全部来源
		SourceVanilla: 仅原版
		SourceModded: 仅模组
	}
}

Configs: {
	ClientConfig: {
		DisplayName: 客户端设置

		InventoryButtonHorizontal: {
			Label: 入口按钮水平位置
			Tooltip: 使用鼠标右键移动按钮后自动保存。
		}

		InventoryButtonVertical: {
			Label: 入口按钮垂直位置
			Tooltip: 使用鼠标右键移动按钮后自动保存。
		}
	}
}
