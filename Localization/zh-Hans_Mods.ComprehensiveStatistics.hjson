	Tabs: {
		Overview: {
			Title: 综合概览
			Description: 这里将显示各类统计的代表性总计和常用摘要。
		}

		Blocks: {
			Title: 物块
			Description: 这里将显示物块挖掘和背景墙拆除统计；家具与多格物体归入物块。
		}

		Items: {
			Title: 物品
			Description: 这里将显示物品拾取、使用与丢弃统计。
		}

		Interactions: {
			Title: 交互
			Description: 这里将显示 NPC 对话及按钮，以及增益站、家具、容器、晶塔、钟和机关的交互统计。
		}

		Kills: {
			Title: 击杀
			Description: 这里将显示角色对 NPC 的最终击杀与协助，以及当前世界的 NPC 实际死亡统计。
		}

		Economy: {
			Title: 经济
			Description: 这里将显示买入、卖出、护士治疗、重铸和货币流量统计。
		}

		Fishing: {
			Title: 钓鱼
			Description: 这里将显示抛竿、上钩、空竿或中断以及渔获统计。
		}

		Movement: {
			Title: 移动
			Description: 这里将显示总移动距离以及各类移动方式的距离统计。
		}

		Survival: {
			Title: 生存
			Description: 这里将显示死亡、掉血和伤害来源统计。
		}
	}

