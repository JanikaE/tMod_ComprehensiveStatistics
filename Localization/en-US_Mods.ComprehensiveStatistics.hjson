Keybinds.ToggleStatistics.DisplayName: Toggle statistics window

UI: {
	WindowTitle: Comprehensive Statistics
	EmptyWindow: Statistics categories will be added in the next development step.
	OpenButtonTooltip:
		'''
		Comprehensive Statistics
		Hold right-click to drag this button
		'''
	CloseButtonTooltip: Close
	StatisticsStartedAt: Statistics started: {0:g}
	StatisticsStartUnavailable: Statistics start time is unavailable outside a world.
	B2PersistenceTestCounter: B2 temporary test · World entries: {0:N0}

	Survival: {
		CategoryColumn: Category
		DeathsColumn: Deaths
		LifeLostColumn: Total life lost
		DeathSourcesGroup: Death count
		DirectDeathGroup: Direct damage
		ContinuousDeathGroup: Damage over time
		UnknownDeathSource: Other or unclassified
		UnclassifiedNpcDeath: Other or unclassified
		DirectDamageGroup: Direct damage
		ContinuousLifeLossGroup: Damage over time
		MultipleContinuousDamageEffects: Multiple damage-over-time effects
		UnknownContinuousLifeLoss: Unknown
		UnclassifiedNpcDamage: Other or unclassified
		MissingNpcContent: Missing content: {0}
		MissingBuffContent: Missing debuff: {0}

		DirectDamageSources: {
			NpcContact: NPC contact damage
			HostileProjectile: Hostile projectile
			PvP: PvP player or projectile
			Fall: Falling
			Drowning: Drowning
			Lava: Lava
			TrapOrTile: Trap or tile
			Other: Other or unclassified
		}
	}

	Items: {
		CombinedGroup: Item statistics
		PickupUnitsColumn: Units picked up
		UseEventsColumn: Uses
		DiscardUnitsColumn: Units discarded
		MissingItemContent: Missing content: {0}
	}

	NPCs: {
		DialogueGroup: NPC dialogue
		FinalKillsGroup: Final kills
		AssistsGroup: Assists
		WorldDeathsGroup: World deaths
		ConversationStarted: Conversation started
		MissingNpcContent: Missing content: {0}

		ChatButtons: {
			ShopFirst: Shop (first button)
			QuestFirst: Quest (first button)
			HelpFirst: Help (first button)
			HealingFirst: Healing (first button)
			TaxCollectionFirst: Collect taxes (first button)
			CurseFirst: Curse (first button)
			CustomFirst: Custom action (first button)
			ShopSecond: Shop (second button)
			WorldStatusOrPurifySecond: World status or purify (second button)
			CraftingSecond: Crafting (second button)
			ReforgeSecond: Reforge (second button)
			HairStyleSecond: Hair style (second button)
			DyeTradeSecond: Strange plant exchange (second button)
			MusicSecond: Music toggle (second button)
			TavernkeepHelpSecond: Eternia Crystal help (second button)
			CustomSecond: Custom action (second button)
		}
	}

	Economy: {
		PurchasesGroup: Purchases
		SalesGroup: Sales
		NurseHealingGroupFormat: Nurse healing ({0:N0} treatments)
		ReforgesGroup: Goblin reforging
		TaxCollectorCollectionsGroup: Tax collection
		SpecialCurrencyPurchasesGroupFormat: Special currency spent ({0})
		TransactionUnitsColumn: Units
		CoinAmountColumn: Currency spent / earned
		MissingMerchantContent: Missing merchant: {0}
		MissingCurrencyContent: Missing currency: {0}
	}

	Fishing: {
		CastsGroup: Casts
		SuccessfulCatches: Successful catches
		EmptyReels: Reeled in without a catch
		InterruptedCasts: Other interruptions
		MissingItemContent: Missing content: {0}

		Liquids: {
			Water: Water
			Honey: Honey
			Lava: Lava
		}
	}

	Movement: {
		MovementModes: Total distance traveled
		PreviouslyUnclassified: Other or unclassified
		NormalOrUnclassifiedJump: Normal or unclassified jump
		MissingItemContent: Missing content: {0}

		Modes: {
			Minecart: Minecart
			OtherMount: Mount
			RopeOrPulley: Rope
			GrapplingHook: Grappling hook
			Flying: Flying
			Jumping: Jumping
			Falling: Falling
			Walking: Walking
		}
	}

	Tabs: {
		Overview: {
			Title: Overview
			Description: Representative totals and frequently used summaries will appear here.
		}

		Blocks: {
			Title: Blocks
			Description: Block, wall, furniture, and multi-tile removal statistics will appear here.
		}

		Items: {
			Title: Items
			Description: Item pickup, use, and discard statistics will appear here.
		}

		Interactions: {
			Title: Interactions
			Description: Buff station, furniture, container, pylon, clock, and mechanism interactions will appear here.
		}

		NPCs: {
			Title: NPCs
			Description: NPC conversations, kills, assists, and world deaths will appear here.
		}

		Economy: {
			Title: Economy
			Description: Purchases, sales, nurse healing, reforging, and currency flow will appear here.
		}

		Fishing: {
			Title: Fishing
			Description: Casts, catches, interrupted casts, and catch details will appear here.
		}

		Movement: {
			Title: Movement
			Description: Total distance and distance by movement type will appear here.
		}

		Survival: {
			Title: Survival
			Description: Deaths, life lost, and damage source statistics will appear here.
		}
	}

	List: {
		NameColumn: Name
		MetricColumn: Units / events
		EventsColumn: Events
		ValueColumn: Value
		DistanceColumn: Distance
		NoResults: No entries match the current filters
		CollapseAll: Collapse all
		ExpandAll: Expand all
		MetricFormat: "{0:N0} units / {1:N0} events"
		EventsFormat: "{0:N0} events"
		AmountFormat: "{0:N0}"
		DistanceFormat: "{0:N2} tiles"
	}

	Toolbar: {
		SearchHint: Search names…
		ScopeCareer: Character career
		ScopeCurrentWorld: Character in world
		ScopeWorldPublic: World public
		ScopeCareerDescription: Scope: this character's full career.
		ScopeCurrentWorldDescription: Scope: this character in the current world.
		ScopeWorldPublicDescription: Scope: public data for the current world.
		ScopedTitleFormat: "{0} · {1}"
		ScopedDescriptionFormat: "{0} {1}"
		SourceAll: All sources
		SourceVanilla: Vanilla only
		SourceModded: Modded only
	}
}

Configs: {
	ClientConfig: {
		DisplayName: Client settings

		InventoryButtonHorizontal: {
			Label: Entry button horizontal position
			Tooltip: Saved automatically when the button is moved with the right mouse button.
		}

		InventoryButtonVertical: {
			Label: Entry button vertical position
			Tooltip: Saved automatically when the button is moved with the right mouse button.
		}
	}
}
