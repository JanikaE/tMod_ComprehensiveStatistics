	Kills: {
		CombinedGroup: NPC kills and deaths
		FinalKillsColumn: Final kills
		AssistsColumn: Assists
		WorldDeathsColumn: World deaths
		MissingNpcContent: Missing content: {0}
	}

	Economy: {
		PurchasesGroup: Purchases
		SalesGroup: Sales
		NurseHealingGroupFormat: Nurse healing ({0:N0} treatments)
		ReforgesGroup: Goblin reforging
		TaxCollectorCollectionsGroup: Tax collection
		SpecialCurrencyPurchasesGroupFormat: Special currency spent ({0})
		TransactionUnitsColumn: Units
		CoinAmountColumn: Currency spent / earned
		MissingMerchantContent: Missing merchant: {0}
		MissingCurrencyContent: Missing currency: {0}
	}

	Fishing: {
		CastsGroup: Casts
		EventsColumn: Events
		UnitsColumn: Units
		SuccessfulCatches: Successful catches
		EmptyReels: Reeled in without a catch
		InterruptedCasts: Other interruptions
		MissingItemContent: Missing content: {0}

		Liquids: {
			Water: Water
			Honey: Honey
			Lava: Lava
		}
	}

	Bait: {
		UsageGroup: Bait usage
		NameFormat: "{0} ({1}% bait power)"
		MissingItemContent: Missing content: {0}
	}

	Movement: {
		MovementModes: Total distance traveled
		PreviouslyUnclassified: Other or unclassified
		NormalOrUnclassifiedJump: Normal or unclassified jump
		MissingItemContent: Missing content: {0}

		Modes: {
			Minecart: Minecart
			OtherMount: Mount
			RopeOrPulley: Rope
			GrapplingHook: Grappling hook
			Flying: Flying
			Jumping: Jumping
			Falling: Falling
			Walking: Walking
		}
	}

	Tabs: {
		Blocks: {
			Title: Blocks
			Description: Block, background wall, wire, and actuator placement or removal statistics appear here; furniture and multi-tile objects are included under Blocks.
		}

		Items: {
			Title: Items
			Description: Item pickup, use, and discard statistics appear here.
		}

		Ammo: {
			Title: Ammo
			Description: Expected use, actual consumption, and consumption rates appear here by ammo category and item.
		}

		Interactions: {
			Title: Interactions
			Description: NPC conversations and actions, plus buff station, furniture, container, pylon, clock, and mechanism interactions will appear here.
		}

		Kills: {
			Title: Kills
			Description: Final kills and assists by this character, plus actual NPC deaths in the current world, will appear here.
		}

		Economy: {
			Title: Economy
			Description: Purchases, sales, nurse healing, reforging, and currency flow will appear here.
		}

		Fishing: {
			Title: Fishing
			Description: Casts, catches, interrupted casts, and catch details appear here.
		}

		Bait: {
			Title: Bait
			Description: Expected use, actual consumption, and consumption rates appear here by bait item.
		}

		Movement: {
			Title: Movement
			Description: Total distance and distance by movement type will appear here.
		}

		Survival: {
			Title: Survival
			Description: Deaths, life lost, and damage source statistics will appear here.
		}
	}

	List: {
		NameColumn: Name
		MetricColumn: Units / events
		EventsColumn: Events
		ValueColumn: Value
		DistanceColumn: Distance
		NoResults: No entries match the current filters
		CollapseAll: Collapse all
		ExpandAll: Expand all
		MetricFormat: "{0:N0} units / {1:N0} events"
		EventsFormat: "{0:N0} events"
		AmountFormat: "{0:N0}"
		DistanceFormat: "{0:N2} tiles"
	}

	Toolbar: {
		SearchHint: Search names…
		ScopeCareer: Character career
		ScopeCurrentWorld: Character in world
		ScopeCareerDescription: Scope: this character's full career.
		ScopeCurrentWorldDescription: Scope: this character in the current world.
		ScopedTitleFormat: "{0} · {1}"
		ScopedDescriptionFormat: "{0} {1}"
		SourceAll: All sources
		SourceVanilla: Vanilla only
		SourceModded: Modded only
	}
}

Configs: {
	ClientConfig: {
		DisplayName: Client settings

		InventoryButtonHorizontal: {
			Label: Entry button horizontal position
			Tooltip: Saved automatically when the button is moved with the right mouse button.
		}

		InventoryButtonVertical: {
			Label: Entry button vertical position
			Tooltip: Saved automatically when the button is moved with the right mouse button.
		}
	}
}
