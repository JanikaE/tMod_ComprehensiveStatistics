			JackOLantern: Explosive jack 'o lanterns
			Nail: Nails
			StyngerBolt: Stynger bolts
			Other: Other or unclassified
		}
	}

	Interactions: {
		DialogueGroup: NPC dialogue
		BuffStationsGroup: Buff stations
		FurnitureGroup: Furniture
		ContainersGroup: Containers
		UtilitiesGroup: Pylons, clocks, and mechanisms
		MissingFacilityContent: Missing facility: {0}
		MissingNpcContent: Missing content: {0}
		ConversationStarted: Conversation started

		ChatButtons: {
			ShopFirst: Shop (first button)
			QuestFirst: Quest (first button)
			HelpFirst: Help (first button)
			HealingFirst: Healing (first button)
			TaxCollectionFirst: Collect taxes (first button)
			CurseFirst: Curse (first button)
			CustomFirst: Custom action (first button)
			ShopSecond: Shop (second button)
			WorldStatusOrPurifySecond: World status or purify (second button)
