Keybinds.ToggleStatistics.DisplayName: Toggle statistics window

UI: {
	WindowTitle: Comprehensive Statistics
	EmptyWindow: Statistics categories will be added in the next development step.
	OpenButtonTooltip:
		'''
		Comprehensive Statistics
		Hold right-click to drag this button
		'''
	CloseButtonTooltip: Close
	StatisticsStartedAt: Statistics started: {0:g}
	StatisticsStartUnavailable: Statistics start time is unavailable outside a world.
	B2PersistenceTestCounter: B2 temporary test · World entries: {0:N0}

	Blocks: {
		SolidTilesGroup: Blocks
		BackgroundWallsGroup: Background walls
		WiringComponentsGroup: Wires and actuators
		WiringPlacedColumn: Placed
		WiringRemovedColumn: Removed
		MissingTileContent: Missing tile: {0}
		MissingWallContent: Missing wall: {0}
		MissingTileObjectContent: Missing furniture or multi-tile object: {0}
		TileObjectStyleFormat: "{0} (style {1})"
		NaturalWallVariantFormat: "{0} (variant {1})"
		NaturalWallFallbackFormat: Natural background wall (type {0})

		NaturalTiles: {
			Cattail: Cattail
			CorruptPlants: Corrupt plants
			MushroomPlants: Mushroom plants
			Plants2: Plants
			SmallPiles: Small piles
			Stalactite: Stalactite
		}

		NaturalWalls: {
			Cavern: Cavern wall
			Ebonstone: Natural ebonstone wall
			Mud: Natural mud wall
			Snow: Natural snow wall
			Amethyst: Natural amethyst wall
			Topaz: Natural topaz wall
			Sapphire: Natural sapphire wall
			Emerald: Natural emerald wall
			Ruby: Natural ruby wall
			Diamond: Natural diamond wall
			CorruptGrass: Natural corrupt grass wall
			HallowedGrass: Natural hallowed grass wall
			Ice: Natural ice wall
			Obsidian: Natural obsidian wall
			CrimsonGrass: Natural crimson grass wall
			Crimstone: Natural crimstone wall
			Corruption: Corruption cavern wall
			Crimson: Crimson cavern wall
			Hallow: Hallow cavern wall
			Lava: Lava cavern wall
			Rocks: Rocky cavern wall
		}

		WiringComponents: {
			RedWire: Red wire
			BlueWire: Blue wire
			GreenWire: Green wire
			YellowWire: Yellow wire
			Actuator: Actuator
		}
	}

	Survival: {
		CategoryColumn: Category
		DeathsColumn: Deaths
		LifeLostColumn: Total life lost
		DeathSourcesGroup: Death count
		DirectDeathGroup: Direct damage
		ContinuousDeathGroup: Damage over time
		UnknownDeathSource: Other or unclassified
		UnclassifiedNpcDeath: Other or unclassified
		DirectDamageGroup: Direct damage
		ContinuousLifeLossGroup: Damage over time
		MultipleContinuousDamageEffects: Multiple damage-over-time effects
		UnknownContinuousLifeLoss: Unknown
		UnclassifiedNpcDamage: Other or unclassified
		MissingNpcContent: Missing content: {0}
		MissingBuffContent: Missing debuff: {0}

		DirectDamageSources: {
			NpcContact: NPC contact damage
			HostileProjectile: Hostile projectile
			PvP: PvP player or projectile
			Fall: Falling
			Drowning: Drowning
			Lava: Lava
			TrapOrTile: Trap or tile
			Other: Other or unclassified
		}
	}

	Items: {
		CombinedGroup: Item statistics
		PickupUnitsColumn: Units picked up
		UseEventsColumn: Uses
		DiscardUnitsColumn: Units discarded
		AmmoExpectedUnitsColumn: Expected use
		AmmoConsumedUnitsColumn: Consumed
		AmmoConsumptionRateColumn: Consumption rate
		CustomAmmoCategoryFormat: "{0} ammo"
		MissingItemContent: Missing content: {0}

		AmmoCategories: {
			Arrow: Arrows
			Bullet: Bullets
			Rocket: Rockets
			Dart: Darts
			Solution: Solutions
			Gel: Gel
			FallenStar: Fallen stars
			Sand: Sand
			Coin: Coins
			Flare: Flares
			Snowball: Snowballs
			Stake: Stakes
