<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Optimize>true</Optimize></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Common/Networking/MagicStorageConfirmation.cs" Link="MagicStorageConfirmation.cs" />
    <Reference Include="$(TmlPath)/tModLoader.dll" Private="false" />
    <Reference Include="$(TmlPath)/Libraries/mono.cecil/**/netstandard2.0/Mono.Cecil.dll" />
    <Reference Include="$(TmlPath)/Libraries/hjson/**/netstandard1.3/Hjson.dll" />
    <Reference Include="$(TmlPath)/Libraries/monomod.*/**/net8.0/*.dll" />
  </ItemGroup>
  <Target Name="RequireTmlPath" BeforeTargets="ResolveReferences" Condition="'$(TmlPath)' == ''">
    <Error Text="Pass -p:TmlPath=the tModLoader install directory." />
  </Target>
</Project>
