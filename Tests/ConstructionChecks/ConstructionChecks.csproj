<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../TileChangeChecks/WorldStubs.cs" Link="WorldStubs.cs" />
    <Compile Include="../LiquidCollectionChecks/NativeILStub.cs" Link="NativeILStub.cs" />
    <Compile Include="../LiquidCollectionChecks/SendDataStub.cs" Link="SendDataStub.cs" />
    <Compile Include="../../Common/Statistics/TileContentSnapshot.cs" Link="TileContentSnapshot.cs" />
    <Compile Include="../../Common/Statistics/TileChangeScope.cs" Link="TileChangeScope.cs" />
    <Compile Include="../../Common/Statistics/TileChangeResult.cs" Link="TileChangeResult.cs" />
    <Compile Include="../../Common/Statistics/TileChangeCandidate.cs" Link="TileChangeCandidate.cs" />
    <Compile Include="../../Common/Systems/ImproveGameConstructionSystem.cs" Link="ImproveGameConstructionSystem.cs" />
    <Compile Include="../../Common/Systems/ImproveGameToolSystem.cs" Link="ImproveGameToolSystem.cs" />
    <Compile Include="../../Common/Systems/ImproveGameMultiplayerSystem.cs" Link="ImproveGameMultiplayerSystem.cs" />
    <Compile Include="../../Common/Systems/ImproveGameClientVerification.cs" Link="ImproveGameClientVerification.cs" />
    <Compile Include="../../Common/Systems/ImproveGameLiquidVerification.cs" Link="ImproveGameLiquidVerification.cs" />
    <Compile Include="../../Common/Systems/StatisticsLiquidSystem.cs" Link="StatisticsLiquidSystem.cs" />
    <Compile Include="../../Common/Statistics/LiquidChangeScope.cs" Link="LiquidChangeScope.cs" />
    <Compile Include="../../Common/Statistics/LiquidChange.cs" Link="LiquidChange.cs" />
    <Compile Include="../../Common/Statistics/LiquidSnapshot.cs" Link="LiquidSnapshot.cs" />
    <Compile Include="../../Common/Networking/ImproveGameProtocol.cs" Link="ImproveGameProtocol.cs" />
    <Compile Include="../../Common/Networking/ImproveGameCapability.cs" Link="ImproveGameCapability.cs" />
    <Compile Include="../../Common/Networking/ImproveGameVersionPolicy.cs" Link="ImproveGameVersionPolicy.cs" />
    <Compile Include="../../Common/Statistics/ImproveGameCompatibilityStatus.cs" Link="ImproveGameCompatibilityStatus.cs" />
    <Reference Include="$(TmlPath)/Libraries/monomod.*/**/net8.0/*.dll" />
    <Reference Include="$(TmlPath)/Libraries/mono.cecil/**/netstandard2.0/*.dll" />
  </ItemGroup>
  <Target Name="RequireTmlPath" BeforeTargets="ResolveReferences" Condition="'$(TmlPath)' == ''">
    <Error Text="Pass -p:TmlPath=the tModLoader install directory to use its bundled MonoMod runtime." />
  </Target>
</Project>
