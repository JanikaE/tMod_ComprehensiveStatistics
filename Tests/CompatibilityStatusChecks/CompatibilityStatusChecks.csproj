<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Common/Networking/ImproveGameCapability.cs" Link="ImproveGameCapability.cs" />
    <Compile Include="../../Common/Networking/ImproveGameVersionPolicy.cs" Link="ImproveGameVersionPolicy.cs" />
    <Compile Include="../../Common/Statistics/ImproveGameCompatibilityStatus.cs" Link="ImproveGameCompatibilityStatus.cs" />
    <Compile Include="../../Common/UI/ImproveGameCompatibilityText.cs" Link="ImproveGameCompatibilityText.cs" />
    <Reference Include="$(TmlPath)/Libraries/hjson/3.0.0/lib/netstandard1.3/Hjson.dll" />
  </ItemGroup>
  <Target Name="RequireTmlPath" BeforeTargets="ResolveReferences" Condition="'$(TmlPath)' == ''">
    <Error Text="Pass -p:TmlPath=the tModLoader install directory." />
  </Target>
</Project>
